# ========================================================================
# Variables de Entorno para Supabase Edge Functions y Resend
# AgendaTenis
# ========================================================================
# NOTA: Nunca expongas credenciales reales en el repositorio git ni en la app Android.
# Configura estos valores en el panel de Supabase: Project Settings -> Edge Functions -> Secrets
# o utilizando el CLI: supabase secrets set RESEND_API_KEY=...

# URL de tu proyecto Supabase (ej. https://xyzcompany.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave Service Role (service_role secret) de Supabase (con privilegios de servidor)
SUPABASE_SERVICE_ROLE_KEY=tu-supabase-service-role-key

# Clave API de Resend obtenida en https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Correo remitente autorizado en Resend (debe ser un dominio verificado o onboarding@resend.dev para pruebas)
RESEND_FROM_EMAIL=AgendaTenis <onboarding@resend.dev>

# Zona horaria de referencia para cálculo de fechas de vencimiento y cron
TIMEZONE=America/Guayaquil
